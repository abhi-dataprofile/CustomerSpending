FROM python:3.9

# Set the working directory
WORKDIR /app/fastapi

# Copy the requirements file and install dependencies
COPY requirements.txt /app/fastapi/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Install additional packages (if not already in requirements.txt)
RUN pip install "fastapi[standard]"
RUN pip install "joblib"
RUN pip install --upgrade pip 
RUN pip install "pandas"
RUN pip install scikit-learn

# Copy the FastAPI application code
COPY ./app/fastapi /app/fastapi/

# Expose the port (default for FastAPI or Cloud Run)
EXPOSE 8000

# Start the FastAPI app
CMD ["python", "/app/fastapi/fastapi_main.py"]